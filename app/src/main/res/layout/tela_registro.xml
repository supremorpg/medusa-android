<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_login"
    android:clipToPadding="false"
    android:padding="24dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000B12" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/auth_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/auth_panel_background"
                android:elevation="10dp"
                android:maxWidth="440dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/auth_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.08"
                    android:text="SUPREMO"
                    android:textColor="#78D64B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/auth_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Entrar no servidor"
                    android:textColor="#FFFFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Acesse sua conta para continuar sua jornada."
                    android:textColor="#B8C5CE"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/auth_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USUÁRIO"
                        android:textColor="#C5D0D7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/auth_username"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/auth_field_background"
                        android:hint="Seu usuário"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLength="24"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#78909C"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/auth_email_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="E-MAIL"
                        android:textColor="#C5D0D7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/auth_email"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/auth_field_background"
                        android:hint="voce@exemplo.com"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLength="96"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#78909C"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="SENHA"
                        android:textColor="#C5D0D7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/auth_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/auth_field_background"
                        android:hint="Sua senha"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLength="64"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#78909C"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/auth_password_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/auth_field_background"
                        android:hint="Confirme sua senha"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLength="64"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#78909C"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/auth_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:textColor="#FFB9C7D0"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp">

                    <Button
                        android:id="@+id/auth_submit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/auth_primary_button"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="ENTRAR"
                        android:textAllCaps="true"
                        android:textColor="#101A14"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/auth_progress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#101A14"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/auth_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Ainda não tem conta?  Criar conta"
                    android:textColor="#78D64B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/auth_close"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:text="FECHAR"
                    android:textColor="#81909A"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
