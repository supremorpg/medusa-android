<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vice_launcher_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="42dp"
        android:paddingEnd="42dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_black"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="VOLTARA"
            android:textAllCaps="true"
            android:textColor="#4CFF4C"
            android:textSize="42sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:fontFamily="@font/montserrat_medium"
            android:letterSpacing="0.42"
            android:text="ROLEPLAY"
            android:textAllCaps="true"
            android:textColor="#DFFFFFFF"
            android:textSize="11sp" />

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="30dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/montserrat_medium"
            android:letterSpacing="0.18"
            android:text="Conectando..."
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
