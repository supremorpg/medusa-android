<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vice_launcher_background"
    android:keepScreenOn="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vice_phone_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:paddingStart="26dp"
        android:paddingTop="18dp"
        android:paddingEnd="26dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/vice_left_panel"
            android:layout_width="206dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingTop="19dp"
            android:paddingEnd="16dp"
            android:paddingBottom="19dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.42"
                android:text="A NEW ROLEPLAY EXPERIENCE"
                android:textAllCaps="true"
                android:textColor="#70FFFFFF"
                android:textSize="5.5sp" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:src="@drawable/logo_supremo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:fadeScrollbars="false">

                <LinearLayout
                    android:id="@+id/menu_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/nav_item_home"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_home"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Inicio"
                            android:src="@drawable/ic_home_off" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nav_label_home"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:letterSpacing="0.28"
                                android:text="INICIO"
                                android:textAllCaps="true"
                                android:textColor="#FFFFFFFF"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="CONTINUAR A HISTORIA"
                                android:textColor="#42FFFFFF"
                                android:textSize="5.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_servers"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_servers"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Servidores"
                            android:src="@drawable/ic_servers_off" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nav_label_servers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:letterSpacing="0.28"
                                android:text="SERVIDORES"
                                android:textAllCaps="true"
                                android:textColor="#88FFFFFF"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="LISTA DE CIDADES"
                                android:textColor="#42FFFFFF"
                                android:textSize="5.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_donate"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_donate"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Loja"
                            android:src="@drawable/ic_shop_off" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nav_label_donate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:letterSpacing="0.22"
                                android:text="MERCADO NEGRO"
                                android:textAllCaps="true"
                                android:textColor="#88FFFFFF"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="LOJA E EXTRAS"
                                android:textColor="#42FFFFFF"
                                android:textSize="5.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_settings"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_settings"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Config"
                            android:src="@drawable/ic_settings_off" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/nav_label_settings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:letterSpacing="0.28"
                                android:text="AJUSTES"
                                android:textAllCaps="true"
                                android:textColor="#88FFFFFF"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="IDENTIDADE E GRAFICOS"
                                android:textColor="#42FFFFFF"
                                android:textSize="5.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_host"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_host"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Host"
                            android:src="@drawable/ic_host_off" />

                        <TextView
                            android:id="@+id/nav_label_host"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0.28"
                            android:text="HOST"
                            android:textAllCaps="true"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_files"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_files"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Arquivos"
                            android:src="@drawable/ic_files_off" />

                        <TextView
                            android:id="@+id/nav_label_files"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0.28"
                            android:text="ARQUIVOS"
                            android:textAllCaps="true"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_editor"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_editor"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Editor"
                            android:src="@drawable/ic_editor_off" />

                        <TextView
                            android:id="@+id/nav_label_editor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0.28"
                            android:text="EDITOR"
                            android:textAllCaps="true"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_workbench"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_workbench"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Ferramentas"
                            android:src="@drawable/ic_tools_off" />

                        <TextView
                            android:id="@+id/nav_label_workbench"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0.28"
                            android:text="TOOLS"
                            android:textAllCaps="true"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_item_credits"
                        android:layout_width="match_parent"
                        android:layout_height="39dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="36dp">

                        <ImageButton
                            android:id="@+id/btn_credits"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:alpha="0"
                            android:background="@android:color/transparent"
                            android:contentDescription="Creditos"
                            android:src="@drawable/ic_credits_off" />

                        <TextView
                            android:id="@+id/nav_label_credits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0.28"
                            android:text="CREDITOS"
                            android:textAllCaps="true"
                            android:textColor="#88FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <View
            android:id="@+id/vice_panel_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="#1BFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/vice_left_panel"
            app:layout_constraintTop_toTopOf="parent" />

        <com.supremo.launcher.launcher.util.ViewPagerWithoutSwipe
            android:id="@+id/fragment_place"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/vice_panel_divider"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/launch_connect_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vice_launcher_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/launch_connect_left_scrim"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:background="#A9000000" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/launch_connect_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="210dp"
                android:background="#24FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/launch_connect_brand"
                android:layout_width="176dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="38dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:letterSpacing="0.36"
                    android:text="A NEW ROLEPLAY EXPERIENCE"
                    android:textAllCaps="true"
                    android:textColor="#55FFFFFF"
                    android:textSize="5.8sp" />

                <TextView
                    android:id="@+id/launch_connect_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:lineSpacingExtra="-6dp"
                    android:text="VOLTARA&#10;RP"
                    android:textColor="#F4FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="italic" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="30dp"
                    android:background="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.22"
                    android:text="CONECTANDO"
                    android:textAllCaps="true"
                    android:textColor="#E8FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:letterSpacing="0.18"
                    android:text="SINCRONIA DO SERVIDOR"
                    android:textAllCaps="true"
                    android:textColor="#55FFFFFF"
                    android:textSize="5.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/launch_connect_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="42dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/launch_connect_divider"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_medium"
                    android:letterSpacing="0.34"
                    android:text="ENTRANDO NO MUNDO"
                    android:textAllCaps="true"
                    android:textColor="#F5FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/launch_connect_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.16"
                    android:text="Sincronizando"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/launch_connect_spinner"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#FFFFFFFF"
                    android:progressBackgroundTint="#24FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/vice_content_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/launch_connect_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Clima, horario e dados RP"
                        android:textColor="#E8FFFFFF"
                        android:textSize="8.2sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="SERVIDOR"
                        android:textAllCaps="true"
                        android:textColor="#76FFFFFF"
                        android:textSize="6.2sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="28dp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.32"
                android:text="BUILD 8.4.12 // WORLD SYNC"
                android:textAllCaps="true"
                android:textColor="#38FFFFFF"
                android:textSize="5.5sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>
