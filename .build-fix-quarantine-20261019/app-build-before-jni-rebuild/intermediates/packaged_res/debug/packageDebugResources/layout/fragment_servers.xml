<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:letterSpacing="0.32"
            android:text="SERVIDORES"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.18"
            android:text="ESCOLHA SUA CIDADE"
            android:textAllCaps="true"
            android:textColor="#76FFFFFF"
            android:textSize="6.8sp" />

        <TextView
            android:id="@+id/server_empty_state"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/vice_content_row"
            android:fontFamily="@font/montserrat_medium"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Nenhum servidor salvo ainda."
            android:textColor="#BFFFFFFF"
            android:textSize="8.8sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/server_add_shortcut"
            android:layout_width="176dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/vice_button_outline"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="ADICIONAR SERVIDOR"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/server_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/montserrat_bold"
        android:letterSpacing="0.32"
        android:text="BUILD 8.4.12 // CINEMATIC SYSTEM"
        android:textAllCaps="true"
        android:textColor="#38FFFFFF"
        android:textSize="5.5sp" />
</FrameLayout>
