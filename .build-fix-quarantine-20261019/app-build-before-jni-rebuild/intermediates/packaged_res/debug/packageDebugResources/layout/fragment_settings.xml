<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="52dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:letterSpacing="0.32"
                android:text="AJUSTES"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.18"
                android:text="IDENTIDADE E PERFORMANCE"
                android:textAllCaps="true"
                android:textColor="#76FFFFFF"
                android:textSize="6.8sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="IDENTIDADE (NICK)"
                android:textColor="#78FFFFFF"
                android:textSize="6.5sp" />

            <TextView
                android:id="@+id/player_name_value"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/vice_field"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="30dp"
                android:paddingEnd="12dp"
                android:text="Jogador_Misterioso"
                android:textColor="@android:color/white"
                android:textSize="8.4sp" />

            <TextView
                android:id="@+id/button_edit_profile"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center_vertical"
                android:text="Use o formato Nome_Sobrenome para servidores de Roleplay."
                android:textColor="#5FFFFFFF"
                android:textSize="5.7sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="LIMITE DE FPS"
                android:textColor="#78FFFFFF"
                android:textSize="6.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/launcher_fps_30"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/vice_button_outline"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:text="30"
                    android:textColor="@android:color/white"
                    android:textSize="7.2sp" />

                <TextView
                    android:id="@+id/launcher_fps_60"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/vice_button_active"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:text="60"
                    android:textColor="#111111"
                    android:textSize="7.2sp" />

                <TextView
                    android:id="@+id/launcher_fps_90"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/vice_button_outline"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:text="90"
                    android:textColor="@android:color/white"
                    android:textSize="7.2sp" />

                <TextView
                    android:id="@+id/launcher_fps_120"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/vice_button_outline"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:text="120"
                    android:textColor="@android:color/white"
                    android:textSize="7.2sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="QUALIDADE GRAFICA"
                android:textColor="#78FFFFFF"
                android:textSize="6.5sp" />

            <TextView
                android:id="@+id/launcher_quality_value"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/vice_field"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Baixo (Performance)"
                android:textColor="@android:color/white"
                android:textSize="8.4sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_add_server_shortcut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/vice_button_outline"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:text="ADICIONAR SERVIDOR"
                    android:textColor="#DFFFFFFF"
                    android:textSize="6.8sp" />

                <TextView
                    android:id="@+id/button_reinstall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/vice_button_outline"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:text="REINSTALAR DATA"
                    android:textColor="#DFFFFFFF"
                    android:textSize="6.8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Teclado Android"
                    android:textColor="#AFFFFFFF"
                    android:textSize="7sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keyboard_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff=""
                    android:textOn="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Voice Chat"
                    android:textColor="#AFFFFFFF"
                    android:textSize="7sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/voip_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff=""
                    android:textOn="" />
            </LinearLayout>

            <Spinner
                android:id="@+id/chat_count_select"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/montserrat_bold"
        android:letterSpacing="0.32"
        android:text="BUILD 8.4.12 // CINEMATIC SYSTEM"
        android:textAllCaps="true"
        android:textColor="#38FFFFFF"
        android:textSize="5.5sp" />
</FrameLayout>
