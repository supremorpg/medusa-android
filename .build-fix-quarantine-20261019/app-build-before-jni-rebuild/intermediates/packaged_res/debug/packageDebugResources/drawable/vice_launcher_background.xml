<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launcher_initial_bg" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E8000000"
                android:centerColor="#43070707"
                android:endColor="#B8000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#42000000"
                android:centerColor="#00000000"
                android:endColor="#A8000000" />
        </shape>
    </item>
</layer-list>
